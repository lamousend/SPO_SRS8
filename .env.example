# Образец переменных окружения. Скопируйте в .env и подставьте свои значения:
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Файл .env находится в .gitignore и не должен попадать в репозиторий.
# Значения ниже - примеры для ЛОКАЛЬНОЙ работы, не рабочие секреты.

# Секретный ключ Django. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# true - режим разработки (подробные ошибки). В облаке всегда false.
DJANGO_DEBUG=true

# Домены/хосты, на которые отвечает Django, через запятую (без схемы https://).
# Локально: localhost,127.0.0.1. На Render: your-app.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Источники с HTTPS для проверки CSRF, через запятую (со схемой).
# Локально можно оставить пустым. На Render: https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Адрес БД. Локально переменную не задавайте - будет SQLite (db.sqlite3).
# В облаке: Internal Database URL из Render, формат:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
